{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EchoNote",
  "version": "0.9.0",
  "identifier": "com.rebill.echonote.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EchoNote",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "resources": {
      "../../asr-service/echonote_asr/__init__.py": "asr-service/echonote_asr/__init__.py",
      "../../asr-service/echonote_asr/__main__.py": "asr-service/echonote_asr/__main__.py",
      "../../asr-service/echonote_asr/app.py": "asr-service/echonote_asr/app.py",
      "../../asr-service/echonote_asr/diarization.py": "asr-service/echonote_asr/diarization.py",
      "../../asr-service/echonote_asr/logging.py": "asr-service/echonote_asr/logging.py",
      "../../asr-service/echonote_asr/model.py": "asr-service/echonote_asr/model.py",
      "../../asr-service/echonote_asr/schemas.py": "asr-service/echonote_asr/schemas.py",
      "../../asr-service/echonote_asr/spike_real_asr.py": "asr-service/echonote_asr/spike_real_asr.py",
      "../../asr-service/echonote_asr/text_sanitizer.py": "asr-service/echonote_asr/text_sanitizer.py",
      "../../asr-service/echonote_asr/transcriber.py": "asr-service/echonote_asr/transcriber.py",
      "../../asr-service/echonote_asr/wav.py": "asr-service/echonote_asr/wav.py",
      "../../asr-service/pyproject.toml": "asr-service/pyproject.toml",
      "../../asr-service/README.md": "asr-service/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
