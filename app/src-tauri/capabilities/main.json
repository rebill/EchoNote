{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: app commands by name and event listening; no plugin APIs, files or shell.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-list-meetings",
    "allow-search",
    "allow-get-meeting",
    "allow-rename-meeting",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-live-snapshot",
    "allow-get-settings",
    "allow-set-settings",
    "allow-list-input-devices",
    "allow-permissions",
    "allow-open-privacy-settings",
    "allow-smoke-report",
    "allow-edit-segment",
    "allow-revert-segment",
    "allow-restore-segment",
    "allow-list-glossary",
    "allow-save-glossary-entry",
    "allow-delete-glossary-entry",
    "allow-export-meeting",
    "allow-delete-meeting",
    "allow-storage-usage",
    "allow-get-ai",
    "allow-save-provider",
    "allow-delete-provider",
    "allow-set-ai-options",
    "allow-consent-provider",
    "allow-test-provider",
    "allow-list-models",
    "allow-save-template",
    "allow-delete-template",
    "allow-summarize",
    "allow-ask",
    "allow-correct-meeting",
    "allow-keep-corrections",
    "allow-revert-correction",
    "allow-clear-qa",
    "allow-cancel-job",
    "allow-running-jobs",
    "allow-get-highlights",
    "allow-asr-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-retranscribe",
    "allow-revert-retranscription"
  ]
}
